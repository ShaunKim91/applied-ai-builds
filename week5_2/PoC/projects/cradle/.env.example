# Copy to .env and adjust if needed. All of these already have sensible
# defaults in backend/app/config.py — you only need this file to override
# something (e.g. change the admin password, or point at a different port).

APP_ENV=production

# --- Security (change SECRET_KEY for anything beyond local demo use) ---
SECRET_KEY=cradle-dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440

# --- Seed admin account (created automatically on first boot) ---
ADMIN_EMAIL=admin@cradle.local
ADMIN_PASSWORD=ChangeMe123!

# --- Model routing (opt-in escalation from the Console page) ---
# Needs api_keys/openrouter.md (in the repo root, four levels up) to
# contain a real key. Off by default — only used when a user explicitly
# clicks "Ask a bigger model instead" on a stalled/completed run.
OPENROUTER_MODEL=qwen/qwen3-8b

# --- Host port (auto-detected by scripts/find_free_port.sh if unset) ---
APP_PORT=8770
