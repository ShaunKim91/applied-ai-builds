# Copy to .env and adjust if needed. All of these already have sensible
# defaults in backend/app/config.py — you only need this file to override
# something (e.g. try the OpenRouter code-gen provider, change the admin
# password, or point at a different port).

APP_ENV=production

# --- Security (change SECRET_KEY for anything beyond local demo use) ---
SECRET_KEY=parchment-dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440

# --- Seed admin account (created automatically on first boot) ---
ADMIN_EMAIL=admin@parchment.local
ADMIN_PASSWORD=ChangeMe123!

# --- LLM provider for OCR-text structuring + PDF/table insight ---
# "local"      (default) -> Qwen2.5-0.5B-Instruct, runs fully offline, no key needed.
# "openrouter" -> qwen/qwen3-8b via OpenRouter. Needs api_keys/openrouter.md
#                 (in the repo root, four levels up) to contain a real key.
#                 Toggle per-request from the PDF Summarizer page UI instead
#                 of changing this default, if you just want to try it once.
LLM_PROVIDER=local
OPENROUTER_MODEL=qwen/qwen3-8b

# --- Host port (auto-detected by scripts/find_free_port.sh if unset) ---
APP_PORT=8740
